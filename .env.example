# Auto-generated by ./setup.sh (config.js -> config.json -> .env). Don't hand-edit
# this expecting it to survive a rerun — edit config.json or answer the prompts.
#
# Infra only. There are no host paths here: every agent container mounts named
# Docker volumes exclusively (a workspace volume per Session, a config volume per
# Account). Accounts are registered in the web UI, and each Session names itself
# and picks its repo there — none of that lives in this file.

# Git identity used for commits Claude makes inside agent containers.
# Auto-detected from the host's global git config; no prompt.
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="your.email@example.com"

# Permission mode for Claude Code inside agent containers.
# auto | default | acceptEdits | plan | dontAsk | bypassPermissions
# 'auto' relies on Claude's background safety classifier — see the README's
# "Auto Mode & Container Sandboxing" section before changing this.
PERMISSION_MODE="auto"

# --- Web Manager & Caddy ---
# Domain name (or host:port) where the manager is exposed.
DOMAIN_NAME="cc.example.com"
# Public origin better-auth signs cookies / builds the OAuth callback against
# (https://<domain> behind Caddy, or http://localhost:4000 locally).
BETTER_AUTH_URL="https://cc.example.com"
# Stable secret better-auth uses to sign sessions. MUST stay constant across
# restarts (a new one logs everyone out) and be >= 32 chars. setup.sh generates one.
BETTER_AUTH_SECRET="change-me-to-a-64-char-random-hex-string-generated-by-setup"
# GitHub OAuth application credentials.
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
# Comma-separated list of GitHub usernames allowed to log in.
# Fail-closed: an empty list denies everyone, so at least one is required.
ALLOWED_GITHUB_USERS="sgomez"
# Internal port for the web manager (default 4000).
WEB_PORT="4000"
# Caddy HTTP port mapping (e.g. 80:80, or 127.0.0.1:40080:80 to disable public HTTP).
CADDY_HTTP_PORT_BIND="80:80"
# Caddy HTTPS port mapping (default 443).
CADDY_HTTPS_PORT="443"
# Active compose profiles. "caddy" to run Caddy, empty to run without it.
COMPOSE_PROFILES="caddy"

# --- Host File Permission Mapping (User Identity Adapter) ---
# Container user/group IDs, matched to the host user so files written into the
# workspace volume aren't root-owned. Auto-detected from `id -u` / `id -g`.
PUID="1000"
PGID="1000"
